# LLM configuration
# LLM_MODEL_NAME: model identifier passed to crewai.LLM (e.g. "qwen-3.5")
LLM_MODEL_NAME=
# LLM_API_KEY: API key for the LLM provider
LLM_API_KEY=
# LLM_BASE_URL: base URL for the LLM API endpoint (e.g. https://api.example)
LLM_BASE_URL=
# LLM_TEMPERATURE: sampling temperature for the LLM (0.0 deterministic, higher => more random)
LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS: maximum tokens the LLM may return (useful to limit costs)
LLM_MAX_TOKENS=10000
# LLM_ENABLE_THINKING: toggle provider 'thinking' feature (true/false)
LLM_ENABLE_THINKING=false

# OpenTelemetry / SDK
# Set to 'true' to disable OTEL instrumentation during local runs
OTEL_SDK_DISABLED=false

# Pattern / agent tuning (defaults mirror current code behavior but can be tuned)
# Number of threads used in the parallel_concurrent pattern
PATTERN_PARALLEL_MAX_WORKERS=3
# How many chunks the parallel pattern retrieves per domain
PATTERN_PARALLEL_MAX_CHUNKS=6

# Handoff (hierarchical) pattern tuning
# Number of scoring threads for handoff worker groups
PATTERN_HANDOFF_MAX_WORKERS=2
# How many worker groups to split selected chunks into
PATTERN_HANDOFF_WORKER_GROUPS=2
# How many chunks the handoff pattern retrieves per domain
PATTERN_HANDOFF_MAX_CHUNKS=8

# Review/critique pattern tuning
# How many chunks to retrieve for the initial estimate
PATTERN_REVIEW_MAX_CHUNKS=6
# How many chunks to retrieve per critique round
PATTERN_REVIEW_CRITIQUE_CHUNKS=4
# How many critique rounds are allowed per domain
PATTERN_REVIEW_MAX_ROUNDS=3

# Experiment CLI defaults
# Path to the preprocessed reports CSV (overrides CLI default if set)
ESG_DATASET_PATH=knowledge/sustainability-reports-preprocessed.csv
# Default sample size used by the experiments
ESG_SAMPLE_SIZE=10
# Default number of trials per report/pattern
ESG_TRIALS=3
# Output path for detailed experiment JSON
ESG_OUTPUT_PATH=output/esg_experiment_results.json
# Directory to serialize chunk stores for retrieval tracing
ESG_CHUNK_STORE_DIR=output/tmp/esg_chunk_store
